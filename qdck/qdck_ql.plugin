#!name = 起点Cookie推送青龙面板
#!desc = 获取起点读书Cookie推送到青龙变量，推送后可触发青龙签到任务，并按插件设置同步任务开关至青龙环境变量。当前版本：V1.01
#!author = bobbyleu
#!homepage = https://github.com/bobbyleu/loonscripts
#!tag = 起点Cookie推送青龙
#!icon = https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/97/40/5e/97405e49-87bb-3f0a-bf3a-91cf8fdf99a0/AppIcon-0-0-1x_U007epad-0-1-0-0-sRGB-GLES2_U002c0-85-220.png/144x144.png
#!arguments-desc = CLIENT_ID/CLIENT_SECRET 为青龙面板开放授权密钥；QL_URL 为青龙面板地址；推送Cookie至青龙面板=获取到Cookie后推送至青龙；推送后触发签到任务=推送成功立即执行青龙签到任务；任务开关每次推送前同步写入青龙环境变量，青龙没有对应变量时自动新建，备注为对应任务名；TASK_KEY 一般保持默认。

[Argument]
CLIENT_ID=input,"",tag=青龙面板CLIENT_ID
CLIENT_SECRET=input,"",tag=青龙面板CLIENT_SECRET
QL_URL=input,"",tag=青龙面板地址
PUSH=switch,"true","false",tag=推送Cookie至青龙面板
RUN_SIGN=switch,"true","false",tag=推送后触发签到任务
TASK_KEY=input,"qdreader",tag=签到任务匹配关键词
ADV_JOB=switch,"true","false",tag=激励任务
EXTRA_ADV_JOB=switch,"true","false",tag=每日任务
LOTTERY=switch,"true","false",tag=每日抽奖
WEEKLY_EXCHANGE=switch,"true","false",tag=每周兑换
CHAPTER_CARD=switch,"true","false",tag=章节卡片
MESSAGE_BOX=switch,"false","true",tag=大咖荐书
CF_ACCESS_ID=input,"",tag=CloudflareAccess客户端ID
CF_ACCESS_SECRET=input,"",tag=CloudflareAccess客户端密钥

[Script]
http-response ^https?:\/\/h5\.if\.qidian\.com\/argus\/api\/v1\/user\/getlogininfo script-path=https://raw.githubusercontent.com/bobbyleu/loonscripts/main/qdck/qdck_ql.js, requires-body=1, tag=起点Cookie推送青龙面板, timeout=60, enable=true, argument=[{CLIENT_ID},{CLIENT_SECRET},{QL_URL},{PUSH},{RUN_SIGN},{TASK_KEY},{ADV_JOB},{EXTRA_ADV_JOB},{LOTTERY},{WEEKLY_EXCHANGE},{CHAPTER_CARD},{MESSAGE_BOX},{CF_ACCESS_ID},{CF_ACCESS_SECRET}]

[MITM]
hostname = %APPEND% h5.if.qidian.com
