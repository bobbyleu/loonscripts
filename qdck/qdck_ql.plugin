#!name = 起点Cookie推送青龙面板
#!desc = 获取起点读书Cookie覆盖写入青龙变量（只保留最新捕获的一个账号），推送后可触发青龙签到任务，最后按插件设置同步任务开关至青龙环境变量（辅助步骤，失败不影响推送与触发）。当前版本：V1.05
#!author = bobbyleu
#!homepage = https://github.com/bobbyleu/loonscripts
#!tag = 起点Cookie推送青龙
#!icon = https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/97/40/5e/97405e49-87bb-3f0a-bf3a-91cf8fdf99a0/AppIcon-0-0-1x_U007epad-0-1-0-0-sRGB-GLES2_U002c0-85-220.png/144x144.png
#!arguments-desc = 第一组为青龙面板凭证：CLIENT_ID/CLIENT_SECRET 为开放授权密钥，QL_URL 为面板地址，CF 项为 Cloudflare Access 服务令牌。第二组为起点任务开关：每次推送完成后同步写入青龙同名环境变量，青龙没有则自动新建，备注为任务名；同步失败会自动熔断并在下次触发补做，不影响 Cookie 推送与签到触发。第三组为行为开关：推送Cookie至青龙面板=获取到Cookie后推送至青龙；推送后触发签到任务=推送成功立即执行青龙签到任务。Cookie 变量名固定为 QDREADER_COOKIE，签到任务按命令含 qdreader 自动匹配。

[Argument]
CLIENT_ID=input,"",tag=青龙面板CLIENT_ID, desc=系统设置-应用设置-开放授权，需 envs+crons 权限
CLIENT_SECRET=input,"",tag=青龙面板CLIENT_SECRET, desc=与 CLIENT_ID 对应的授权密钥
QL_URL=input,"",tag=青龙面板地址, desc=手机需能访问该地址，Tailscale / cloudflared / 局域网均可
CF_ACCESS_ID=input,"",tag=CloudflareAccess客户端ID, desc=可选，青龙域名在 Cloudflare Access 后面时填写
CF_ACCESS_SECRET=input,"",tag=CloudflareAccess客户端密钥, desc=可选，与 CF_ACCESS_ID 配对使用
ADV_JOB=switch,"true","false",tag=激励任务, desc=同步至青龙变量 QDREADER_ADV_JOB_ENABLE
EXTRA_ADV_JOB=switch,"true","false",tag=每日任务, desc=同步至青龙变量 QDREADER_EXTRA_ADV_JOB_ENABLE
LOTTERY=switch,"true","false",tag=每日抽奖, desc=同步至青龙变量 QDREADER_LOTTERY_ENABLE
WEEKLY_EXCHANGE=switch,"true","false",tag=每周兑换, desc=同步至青龙变量 QDREADER_WEEKLY_EXCHANGE_ENABLE
CHAPTER_CARD=switch,"true","false",tag=章节卡片, desc=同步至青龙变量 QDREADER_CHAPTER_CARD_ENABLE
MESSAGE_BOX=switch,"false","true",tag=大咖荐书, desc=同步至青龙变量 QDREADER_MESSAGE_BOX_ENABLE，默认关闭
PUSH=switch,"true","false",tag=推送Cookie至青龙面板, desc=开=获取到Cookie即推送并覆盖青龙变量（只保留最新账号）；关=仅抓取不推送，也不写青龙
RUN_SIGN=switch,"true","false",tag=推送后触发签到任务, desc=开=推送成功后立即执行青龙签到任务；关=只更新变量

[Script]
http-response ^https?:\/\/h5\.if\.qidian\.com\/argus\/api\/v1\/user\/getlogininfo script-path=https://raw.githubusercontent.com/bobbyleu/loonscripts/main/qdck/qdck_ql.js, requires-body=1, tag=起点Cookie推送青龙面板, timeout=60, enable=true, argument=[{CLIENT_ID},{CLIENT_SECRET},{QL_URL},{CF_ACCESS_ID},{CF_ACCESS_SECRET},{ADV_JOB},{EXTRA_ADV_JOB},{LOTTERY},{WEEKLY_EXCHANGE},{CHAPTER_CARD},{MESSAGE_BOX},{PUSH},{RUN_SIGN}]

[MITM]
hostname = %APPEND% h5.if.qidian.com
