#!name = 京东CK自动推送青龙面板
#!desc = 获取京东CK，推送到青龙面板。当前版本：V1.40
#!author = bobbyleu
#!homepage = https://github.com/bobbyleu/loonscripts
#!tag = 京东CK自动推送
#!icon = https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/0b/0e/ad/0b0eaddf-8cc3-7843-954c-f96691d8d814/AppIcon-0-0-1x_U007epad-0-1-0-0-85-220.png/144x144.png
#!arguments-desc = CLIENT_ID/CLIENT_SECRET 为青龙面板开放授权密钥；推送CK至青龙面板=获取到pt_key后强制推送至青龙面板；QL_URL 为青龙面板地址。

[Argument]
CLIENT_ID=input,"",tag=青龙面板CLIENT_ID
CLIENT_SECRET=input,"",tag=青龙面板CLIENT_SECRET
QL_URL=input,"",tag=青龙面板地址
PUSH=switch,"true","false",tag=推送CK至青龙面板
CF_ACCESS_ID=input,"",tag=CloudflareAccess客户端ID
CF_ACCESS_SECRET=input,"",tag=CloudflareAccess客户端密钥

[Script]
http-request ^https?:\/\/api\.m\.jd\.com\/client\.action\?$ script-path=https://raw.githubusercontent.com/bobbyleu/loonscripts/main/jdck/jdck_ql.js,tag=京东CK自动推送青龙面板,requires-body=false,timeout=60,enable=true,argument=[{CLIENT_ID},{CLIENT_SECRET},{PUSH},{QL_URL},{CF_ACCESS_ID},{CF_ACCESS_SECRET}]

[Mitm]
hostname = %APPEND% api.m.jd.com
