#!name = 京东CK自动获取与推送青龙面板
#!desc = 获取京东CK，推送到青龙面板。
#!author = @bobbyleu
#!loon_version = 3.5.1(983)
#!arguments-desc = CLIENT_ID/CLIENT_SECRET 为青龙开放授权密钥；推送青龙=获取到pt_key后强制推送到青龙；pt_key获取通知=关闭后半小时内只通知一次、否则即时通知；QL_URL 为青龙面板地址（必填）。

[Argument]
CLIENT_ID=input,"",tag=青龙CLIENT_ID, desc=青龙「系统设置-应用设置-开放授权」的 Client ID（请手动填写，首次填写后自动缓存）
CLIENT_SECRET=input,"",tag=青龙CLIENT_SECRET, desc=青龙「系统设置-应用设置-开放授权」的 Client Secret（请手动填写，首次填写后自动缓存）
QL_URL=input,"",tag=青龙地址, desc=青龙面板地址（必填，如 https://your-domain.com；不填写则不会推送）
PUSH=switch,"true","false",tag=推送青龙, desc=获取到pt_key后强制推送到青龙面板
NOTIFY_UNCHANGED=switch,"false","true",tag=pt_key获取通知, desc=关闭后，pt_key半小时内只通知一次；否则，获取到pt_key即时通知。

[Script]
http-request ^https?:\/\/api\.m\.jd\.com script-path=https://raw.githubusercontent.com/bobbyleu/loonscripts/main/jdck/jdck_ql.js,tag=京东CK自动获取与推送青龙面板,requires-body=false,timeout=60,enable=true,argument=[{CLIENT_ID},{CLIENT_SECRET},{PUSH},{NOTIFY_UNCHANGED},{QL_URL}]

[Mitm]
hostname = %APPEND% api.m.jd.com
